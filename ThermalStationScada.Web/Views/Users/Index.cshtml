@model List<UserRoleRow>
<h2>Users</h2>
<p class="text-success">@TempData["Message"]</p>
<table class="table">
    <tr><th>Email</th><th>Role</th></tr>
    @foreach (UserRoleRow u in Model)
    {
        <tr>
            <td>@u.Email</td>
            <td>
                <form method="post" asp-action="SetRole" class="d-flex gap-2">
                    <input type="hidden" name="id" value="@u.Id" />
                    <select name="role" class="form-select w-auto">
                        @foreach (string r in (string[])ViewBag.Roles)
                        {
                            <option value="@r"
                                    selected="@(r == u.Role)">@r</option>
                        }
                    </select>
                    <button class="btn btn-primary">Apply</button>
                </form>
            </td>
        </tr>
    }
</table>
